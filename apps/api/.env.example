# Configuration de l'API QCM

# Port du serveur
PORT=3001

# Clé secrète pour JWT (doit être longue et aléatoire)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Durées de validité des tokens (en secondes)
JWT_ACCESS_EXPIRES_IN=86400 # 24 heures
JWT_REFRESH_EXPIRES_IN=604800 # 7 jours

# Configuration de la base de données SQLite
DATABASE_URL="file:./prisma/dev.db"

# Répertoire de stockage des médias
MEDIA_UPLOAD_DIR="./uploads/media"

# Taille maximale des médias (en octets)
MAX_IMAGE_SIZE=5242880 # 5 Mo
MAX_AUDIO_SIZE=20971520 # 20 Mo
MAX_VIDEO_SIZE=104857600 # 100 Mo

# Configuration CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Limite de taux (requests par minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Mode de développement
NODE_ENV=development

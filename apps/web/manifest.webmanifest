{
  "name": "QCM App",
  "short_name": "QCM",
  "description": "Application de QCM pour apprendre l'anglais et d'autres matières. Fonctionne hors ligne.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#3b82f6",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/pwa-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Écran d'accueil de l'application QCM"
    },
    {
      "src": "/screenshot-2.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mode quiz sur mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Nouveau Quiz",
      "short_name": "Nouveau",
      "description": "Créer un nouveau quiz",
      "url": "/quizzes/new",
      "icons": [
        {
          "src": "/icon-new.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Aujourd'hui",
      "short_name": "Aujourd'hui",
      "description": "Révision du jour",
      "url": "/today",
      "icons": [
        {
          "src": "/icon-today.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Statistiques",
      "short_name": "Stats",
      "description": "Tableau de bord des statistiques",
      "url": "/stats",
      "icons": [
        {
          "src": "/icon-stats.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "iarc_protocol_allowlist": [],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "protocol_handlers": [
    {
      "protocol": "web+qcmapp",
      "url": "/open?url=%s"
    }
  ],
  "share_target": {
    "action": "/import",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "description",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [".json", ".zip"]
        }
      ]
    }
  }
}
